# App Config
FRONTEND_URL=http://localhost:5173
SECURE=false

# Database
DBMS_CONNECTION=jdbc:mysql://localhost:3306/test?sslMode=REQUIRED
DBMS_USERNAME=root
DBMS_PASSWORD=your_db_password
DDL_AUTO=update

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
SIGNER_KEY=bXktc3VwZXItbG9uZy1zZWNyZXQta2V5LWZvci1qc3ctaHM1MTItc2VjdXJlLXRva2VuLWFwcGxpY2F0aW9uLTIwMjY=

# Google OAuth2
CLIENT_ID=your_google_client_id
CLIENT_SECRET=your_google_client_secret

# MailerSend SMTP Configuration
SMTP_HOST=smtp.mailersend.net
SMTP_PORT=587
# Username MailerSend cung cấp (ví dụ: MS_xxxx@trial-xxxx.mailersend.net)
SMTP_USERNAME=your_mailersend_username
# Mật khẩu SMTP hoặc API token (tùy theo cấu hình trên MailerSend)
SMTP_PASSWORD=your_mailersend_password
# Địa chỉ email gửi đi (phải là domain đã verify trên MailerSend)
SMTP_FROM_EMAIL=your_verified_email@yourdomain.com
