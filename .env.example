# App Config
FRONTEND_URL=http://localhost:5173
SECURE=false

# Database
DBMS_CONNECTION=jdbc:mysql://localhost:3306/test?sslMode=REQUIRED
DBMS_USERNAME=root
DBMS_PASSWORD=your_db_password
DDL_AUTO=update

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
SIGNER_KEY=123

# Google OAuth2
CLIENT_ID=your_google_client_id
CLIENT_SECRET=your_google_client_secret

# Mailtrap SMTP Configuration
# Nếu dùng Mailtrap Email Sending (Gửi thật): SMTP_HOST=live.smtp.mailtrap.io hoặc send.smtp.mailtrap.io
# Nếu dùng Mailtrap Email Testing (Gửi test): SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
# Username của Mailtrap (luôn là "api" đối với Email Sending, hoặc username của Sandbox)
SMTP_USERNAME=api
# Mật khẩu SMTP hoặc API key bạn vừa tạo trên Mailtrap
SMTP_PASSWORD=your_mailtrap_api_key
# Địa chỉ email gửi đi (Domain phải được verify trên Mailtrap nếu dùng chức năng gửi thật)
SMTP_FROM_EMAIL=your_verified_email@yourdomain.com
